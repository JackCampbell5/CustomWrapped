{
  "name": "jacks-wrapped",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jack's Wrapped: a local, private year-in-review built from a Spotify data export.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.js",
    "build:data:offline": "node scripts/build-data.js --no-enrich",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
