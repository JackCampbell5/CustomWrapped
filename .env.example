# Spotify Web API credentials (optional: the app works without them, using generated art).
# Get them at https://developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:8888/callback
#   API: Web API
# Then open the app's Settings and copy the Client ID and Client Secret below.
# Copy this file to .env and fill in the values. Never commit .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
